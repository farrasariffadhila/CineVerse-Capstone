<?xml version="1.0" encoding="utf-8"?>
<!--
    Aturan Backup & Transfer untuk perangkat API 31+.
    Sama seperti backup_rules.xml: database terenkripsi SQLCipher dikecualikan
    dari cloud backup maupun device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="Movie.db" />
        <exclude
            domain="database"
            path="Movie.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="Movie.db" />
        <exclude
            domain="database"
            path="Movie.db-journal" />
    </device-transfer>
</data-extraction-rules>
