<?xml version="1.0" encoding="utf-8"?>
<!--
    Aturan Auto Backup untuk perangkat API < 31.
    Database "Movie.db" dienkripsi dengan SQLCipher memakai passphrase milik
    aplikasi, sehingga file-nya tidak berguna (bahkan berpotensi korup) bila
    dipulihkan ke perangkat lain. Karena itu database dikecualikan dari backup;
    data film selalu bisa diambil ulang dari TMDB API.
-->
<full-backup-content>
    <exclude
        domain="database"
        path="Movie.db" />
    <exclude
        domain="database"
        path="Movie.db-journal" />
</full-backup-content>
